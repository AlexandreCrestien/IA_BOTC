# Configuration locale du jeu : copier ce fichier en .env (cp .env.example .env).
# Projet de formation, à lancer en local : tout est déjà renseigné, sauf les clés d'API des LLM.

# --- Clés d'API des LLM (gratuites, à créer soi-même : voir le README) ---
# Au moins une ; le jeu bascule automatiquement entre les modèles disponibles.
# Sans aucune clé : SIMULATE_LLM=1 uv run main.py (les IA répondent au hasard parmi les choix possibles).
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- Connexion des joueurs ---
# Clé de signature des jetons de connexion. VALEUR DE DÉMONSTRATION, publique puisqu'elle est dans le dépôt :
# pour tout usage réel, la remplacer par une clé secrète générée avec : openssl rand -hex 32
JWT_SECRET=e7a44fc194bbc8d5e0b2445fe39ee056bc3f7ff57bab520cba9da10e4a63fc7a

# --- Compte administrateur (panneau http://127.0.0.1:8000/admin), créé au démarrage du serveur ---
# Identifiants de démonstration : à changer pour tout usage réel (mot de passe : 8 caractères au moins).
ADMIN_PSEUDO=admin
ADMIN_PASSWORD=lantern-admin
ADMIN_EMAIL=admin@lantern-hollow.local
# Adresse à contacter, indiquée dans les e-mails de sécurité (vide : ADMIN_EMAIL)
CONTACT_EMAIL=

# --- E-mails (confirmation de l'adresse, mot de passe oublié, notifications de sécurité) ---
# smtp : envoyés à Mailpit (lancé par docker compose), visibles sur http://localhost:8025. Rien ne part vraiment.
# console : affichés dans la console du serveur (sans Docker).
MAIL_MODE=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=Lantern Hollow <no-reply@lantern-hollow.local>
# Adresse du jeu dans les liens des e-mails
APP_URL=http://127.0.0.1:8000

# --- Base de données PostgreSQL, lancée par docker compose up -d (docker-compose.yml lit aussi ces valeurs) ---
POSTGRES_USER=lantern
POSTGRES_PASSWORD=lantern
POSTGRES_DB=lantern_hollow
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://lantern:lantern@localhost:5432/lantern_hollow
# Sans Docker : laisser DATABASE_URL vide (fichier SQLite data/lantern_hollow.db) et passer MAIL_MODE à console.

# Facultatif : lancer aussi les tests sur PostgreSQL (base créée par docker/postgres-init.sql).
# TEST_DATABASE_URL=postgresql+psycopg://lantern:lantern@localhost:5432/lantern_hollow_test
