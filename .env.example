GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Clé de signature des jetons de connexion. Absente : clé temporaire, les joueurs sont déconnectés au redémarrage.
JWT_SECRET=

# Compte administrateur, créé au premier démarrage s'il n'existe pas (mot de passe : 8 caractères au moins).
# Absent : aucun compte admin, le panneau /admin est inaccessible. ADMIN_EMAIL est facultatif.
ADMIN_PSEUDO=
ADMIN_PASSWORD=
ADMIN_EMAIL=

# E-mails (mot de passe oublié, avertissement avant suppression d'un compte inactif).
# MAIL_MODE=console : rien n'est envoyé, l'e-mail s'affiche dans la console du serveur (par défaut).
# MAIL_MODE=smtp : envoi à Mailpit (docker-compose.yml), e-mails visibles sur http://localhost:8025
MAIL_MODE=console
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=Lantern Hollow <no-reply@lantern-hollow.local>
# Adresse du jeu dans les liens des e-mails
APP_URL=http://127.0.0.1:8000

# Base de données PostgreSQL, lancée par `docker compose up -d` (docker-compose.yml lit aussi ces valeurs).
POSTGRES_USER=lantern
POSTGRES_PASSWORD=lantern
POSTGRES_DB=lantern_hollow
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://lantern:lantern@localhost:5432/lantern_hollow
# Sans Docker : laisser DATABASE_URL vide, le jeu utilise alors un fichier SQLite (data/lantern_hollow.db).

# Facultatif : lancer aussi les tests sur PostgreSQL (base créée par docker/postgres-init.sql).
# TEST_DATABASE_URL=postgresql+psycopg://lantern:lantern@localhost:5432/lantern_hollow_test
