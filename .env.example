GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Clé de signature des jetons de connexion. Absente : clé temporaire, les joueurs sont déconnectés au redémarrage.
JWT_SECRET=

# Compte administrateur, créé au premier démarrage s'il n'existe pas (mot de passe : 8 caractères au moins).
# Absent : aucun compte admin, le panneau /admin est inaccessible.
ADMIN_PSEUDO=
ADMIN_PASSWORD=

# Base de données (facultatif). Par défaut : fichier SQLite data/lantern_hollow.db
# DATABASE_URL=sqlite:///data/lantern_hollow.db
